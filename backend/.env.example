# Copiez ce fichier en ".env" en local, et reportez les mêmes clés dans
# les "Environment Variables" du service Render en production.
# Ne JAMAIS committer le vrai fichier .env (déjà exclu par .gitignore).

# ===== Base de données MySQL =====
DB_HOST=
DB_USER=
DB_PASSWORD=
DB_NAME=
DB_PORT=3306

# ===== Authentification =====
JWT_SECRET=
ADMIN_USER=
ADMIN_PASS=

# ===== CORS =====
# URL du frontend déployé (Vercel/Netlify), sans slash final.
# Ex : https://mon-projet-web.vercel.app
FRONTEND_URL=

# ===== Envoi d'emails (préinscription, notifications) =====
EMAIL_USER=
EMAIL_PASS=

# ===== Divers =====
# Render fournit PORT automatiquement — ne pas le définir soi-même en production.
PORT=3000
NODE_ENV=development
